# ── web-admin ──────────────────────────────────────────────────────────────
# Doppler service token for the prd_web_admin config. Used at build time
# (Sentry/env) and at runtime (Supabase, Influx, alerter secrets all come
# from Doppler — not from this file).
DOPPLER_TOKEN=

# ── alerter ──────────────────────────────────────────────────────────────────
# Doppler service token for the root prd config. Supabase, Influx,
# Discord/Telegram, and ALERT_ENV all come from Doppler — not from this file.
ALERTER_DOPPLER_TOKEN=
# healthchecks.io check URL (dead-man's switch), pinged by the alerter after
# every tick. Optional; empty disables.
HEALTHCHECKS_PING_URL=

# ── caddy ────────────────────────────────────────────────────────────────────
ADMIN_DOMAIN=admin.streamwizard.org

# ── telegraf → existing external InfluxDB ────────────────────────────────────
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUX_BUCKET_PROD=streamwizard-prod
INFLUX_BUCKET_STAGING=streamwizard-staging

# ── telegraf ← Supabase platform metrics ─────────────────────────────────────
# https://<project-ref>.supabase.co/customer/v1/privileged/metrics
# The secret keys are each project's service-role key (Basic auth password;
# username is always "service_role").
SUPABASE_METRICS_URL_PROD=
SB_SECRET_KEY_PROD=
SUPABASE_METRICS_URL_STAGING=
SB_SECRET_KEY_STAGING=
