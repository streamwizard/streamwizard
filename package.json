{
  "name": "twitch-tools",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:main": "turbo run dev --filter=@repo/web-streamwizard --filter=@repo/web-overlay  --filter=@repo/ws-server   --filter=@repo/web-admin ",
    "dev:admin": "turbo run dev --filter=@repo/web-admin",
    "dev:docs": "turbo run dev --filter=@repo/docs",
    "clean": "rm -rf apps/*/.next",
    "doppler:sync": "bash scripts/sync-doppler-shared.sh",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "bun x turbo run check-types",
    "gen-types": "supabase gen types typescript --project-id jgxdrljoqployiyjedst --schema public > packages/supabase/src/types/supabase.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "shadcn": "^4.11.0",
    "turbo": "^2.9.15",
    "typescript": "5.9.2"
  },
  "overrides": {
    "next": "16.2.12",
    "@sentry/core": "10.56.0",
    "@sentry/bun": "10.56.0",
    "@sentry/hono": "10.56.0",
    "dompurify": "^3.4.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "server-only": "^0.0.1"
  }
}
