# Dependencies
node_modules
.pnp
.pnp.js

# MCP server config (can contains API keys)
.mcp.json

# Local env files
.env
supabase/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
*~

# JetBrains IDEs
.idea/

# Wrangler local dev state
.wrangler/

# Mintlify local cache
.mintlify/

# Claude Code local settings (per-user permission overrides)
**/.claude/settings.local.json

# VS Code personal/machine-specific settings (tasks.json and extensions.json stay tracked)
.vscode/settings.json
.vscode/launch.json
*.code-workspace

# TypeScript incremental build info
*.tsbuildinfo

# Next.js generated type shim (regenerated on every dev/build)
next-env.d.ts

# Local agent/skill tooling state (per-machine, not part of the product)
.agents/
.impeccable/
**/.impeccable/
**/.claude/settings.json
**/.claude/skills/
