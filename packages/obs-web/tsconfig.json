{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    // @repo/ui's own sources import through its "@/*" alias. Type-checking this
    // package pulls those files in, so the alias has to resolve here too.
    "paths": {
      "@/*": ["../ui/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
