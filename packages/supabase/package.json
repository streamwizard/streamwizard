{
  "name": "@repo/supabase",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next/server": {
      "types": "./src/next/server.ts",
      "default": "./src/next/server.ts"
    },
    "./next/client": {
      "types": "./src/next/client.ts",
      "default": "./src/next/client.ts"
    },
    "./next/admin": {
      "types": "./src/next/admin.ts",
      "default": "./src/next/admin.ts"
    },
    "./next/proxy": {
      "types": "./src/next/proxy.ts",
      "default": "./src/next/proxy.ts"
    },
    "./auth/session-strength": {
      "types": "./src/auth/session-strength.ts",
      "default": "./src/auth/session-strength.ts"
    },
    "./queries/*": {
      "types": "./src/queries/*.ts",
      "default": "./src/queries/*.ts"
    },
    "./types/supabase": {
      "types": "./src/types/supabase.ts",
      "default": "./src/types/supabase.ts"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./src/crypto.ts"
    },
    "./anon": {
      "types": "./src/anon.ts",
      "default": "./src/anon.ts"
    },
    "./request-client": {
      "types": "./src/request-client.ts",
      "default": "./src/request-client.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "gen-types": "supabase gen types typescript --project-id jgxdrljoqployiyjedst --schema public > src/types/supabase.ts"
  },
  "dependencies": {
    "@repo/metrics": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/sentry": "workspace:*",
    "@repo/types": "workspace:*",
    "@supabase/supabase-js": "^2.105.1",
    "@supabase/ssr": "^0.12.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.8",
    "typescript": "^5.9.2"
  }
}
